# Money Copilot — environment variables (Sprint 3: Open Finance sandbox)
#
# Copy this file to .env.local (in apps/web/) or export these in your shell.
# NEVER commit a file containing real values — only this placeholder file is
# tracked in git.

# ---- Pluggy (server-only secrets — see docs/OPEN-FINANCE.md) ----
# Obtain these from your Pluggy dashboard (sandbox application). They are
# used ONLY on the server (packages/open-finance) to mint a short-lived API
# key and Connect Token — the browser never receives them.
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=

# Optional: shared secret appended to the webhook URL registered with
# Pluggy, as a lightweight protection mechanism (Pluggy does not document a
# payload-signature scheme — see docs/OPEN-FINANCE.md, "Webhook security").
# Leave unset to disable this check locally.
PLUGGY_WEBHOOK_SECRET=

# Public base URL of this app, used to construct the webhook URL registered
# with Pluggy (must be HTTPS for Pluggy to accept it, except when
# ENABLE_HTTP_WEBHOOK=true for local http tunnels during development).
# Leave unset to skip webhook registration (manual "Refresh / sync" still
# works — see docs/OPEN-FINANCE.md, "Manual sync vs. provider auto-sync").
NEXT_PUBLIC_APP_URL=
ENABLE_HTTP_WEBHOOK=false

# ---- OpenAI (server-only secret — see docs/AI-COPILOT.md) ----
# Used ONLY on the server (packages/ai) to call the OpenAI Responses API —
# never exposed to the browser, persisted in the DB, logged, or committed.
# Leave unset to run without live AI chat: the deterministic dashboard
# (Sprints 1-3) keeps working, and /api/chat returns a clear
# AI_CONFIGURATION_ERROR instead of silently degrading. Automated tests
# never require this — they use MockAIProvider.
OPENAI_API_KEY=

# Overrides the default AI model (gpt-5.6-terra). Leave unset to use the
# default — see docs/AI-COPILOT.md, "Model configuration."
OPENAI_MODEL=

# ---- Local persistence ----
# Path to the local PGlite (embedded Postgres-compatible) data file. No
# hosted database or credentials are required for local dev or tests.
MONEY_COPILOT_DB_PATH=./.data/money-copilot.pglite
