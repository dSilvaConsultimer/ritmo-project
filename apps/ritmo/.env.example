# Ritmo (apps/ritmo) — environment variables
#
# Copy to apps/ritmo/.env.local (gitignored — never commit a file with real
# values). This app has its own env file, separate from the repo-root
# .env.example (which documents apps/web, the internal/debug app).

# ---- Environment tier (Sprint 9) ----
# One of: development | test | staging | production. Authoritative when set —
# resolved via @money-copilot/config's resolveAppEnvironment(), which several
# production safety checks depend on (never seeding fixture data, never
# booting against file-backed PGlite, never allowing a dev-only bypass flag)
# in staging/production. Leave unset locally — it defaults to "development".
APP_ENV=

# ---- Dev-only auth bypass (Sprint 9 Phase 4 fix-up — see docs/DECISIONS.md DEC-104) ----
# NEVER set this to "true" as a default. When "true" AND APP_ENV/NODE_ENV resolve to
# development or test, EVERY request is treated as already authenticated as the
# Founder/demo fixture profile — the real Better Auth login/session check never
# runs at all. This exists only for narrow automated/developer scenarios (e.g.
# scripting against a protected route without going through a real login first),
# never for normal day-to-day browsing — the normal local product experience
# must exercise the real /login flow. Leave unset (or "false"): the default,
# correct, real-auth behavior needs no value here at all. Has no effect in
# staging/production regardless of value (enforced twice: the environment
# check here, and assertDevOnlyFlagNotInProduction()'s own fail-closed guard).
DEV_AUTH_BYPASS=

# ---- Preflight access (Sprint 9 Phase 6A — see docs/DECISIONS.md DEC-118) ----
# Operational secret gating GET /api/preflight in staging/production (sent as
# an X-Preflight-Secret header). Leave unset in a live tier and the route is
# completely unavailable (404) by default — set it only when you actually
# need to curl /api/preflight as part of a deploy check. Not required in
# development/test, where the route is always reachable. Generate a real
# value with `openssl rand -base64 32`, same as BETTER_AUTH_SECRET.
PREFLIGHT_SECRET=

# ---- Production database (Sprint 9, staging/production only — see docs/DECISIONS.md DEC-090/092) ----
# A real Postgres connection string (Neon or otherwise) — the RUNNING
# APPLICATION's own connection only. Required whenever APP_ENV is staging or
# production — @money-copilot/app-services refuses to start without it in
# that case, and never falls back to PGlite. Use Neon's POOLED connection
# string here. Leave unset locally; development/test use
# MONEY_COPILOT_DB_PATH below instead.
DATABASE_URL=

# ---- Migration database (Sprint 9 Phase 6A — see docs/DECISIONS.md DEC-119) ----
# A SEPARATE Postgres connection string used ONLY by the explicit migration
# command (`pnpm --filter @money-copilot/persistence run db:migrate:postgres`)
# — never read by the running application itself. Use Neon's DIRECT
# (unpooled) connection string here — Drizzle's migrator runs DDL, which
# Neon documents as less predictable through its pooler than DATABASE_URL's
# pooled connection is for ordinary queries. Required wherever that migration
# command runs (typically Railway's Pre-Deploy Command step); the running app
# never needs this variable at all. Leave unset locally.
DATABASE_DIRECT_URL=

# ---- Better Auth (Sprint 9 Phase 3 fix-up — see docs/DECISIONS.md DEC-097) ----
# Session-signing secret. Required whenever APP_ENV is staging or production —
# @money-copilot/config's requireEnv() throws and the app refuses to start
# without it in that case; it never falls back to Better Auth's own implicit
# default secret there. Leave unset locally: development/test use an explicit,
# clearly-named, checked-into-source dev-only fallback instead (see
# apps/ritmo/src/functions/auth-config.server.ts) — never silently generated.
# Generate a real value for staging/production with `openssl rand -base64 32`.
BETTER_AUTH_SECRET=

# The app's own public base URL (e.g. https://ritmo.example.com). Required
# whenever APP_ENV is staging or production, for the same reason as above —
# Better Auth uses it for callback/redirect URLs and cookie scoping. Leave
# unset locally: Better Auth derives the origin from each incoming request,
# which is fine for a single local dev host.
BETTER_AUTH_URL=

# ---- Transactional email — Resend (Founder-selected, Sprint 9 Phase 6A — see
# docs/DECISIONS.md DEC-098/DEC-120) ----
# Leave all three unset: password recovery (`/recuperar-senha`) is only
# offered when APP_ENV is development/test (where the reset link is captured
# in-memory instead of emailed — see email.server.ts) or when ALL THREE of
# these are set. Partial configuration (e.g. the provider name alone) is
# deliberately treated as "not configured" — password reset stays honestly
# unavailable and docs/DECISIONS.md DEC-113's preflight check keeps flagging
# it as a GO_LIVE blocker until all three are real.
TRANSACTIONAL_EMAIL_PROVIDER=resend

# Server-only Resend API key. Never sent to the browser, never logged (see
# apps/ritmo/src/functions/email-resend.server.ts).
RESEND_API_KEY=

# The verified sender address/display name Resend sends from, e.g.
# "Ritmo <naoresponda@ritmo.example.com>" — the domain must be verified in
# Resend's own dashboard before this works (a Resend-side setup step, not
# something this codebase can do for you).
TRANSACTIONAL_EMAIL_FROM=

# ---- Pluggy / Open Finance (Sprint 9 Phase 4 — see docs/OPEN-FINANCE.md) ----
# Server-only credentials for the real Pluggy Connect Token flow
# (src/functions/connections.server.ts). Leave unset to run without a real
# bank-connection flow: the onboarding/bank-connection screen returns a
# clear configuration-error state instead of silently degrading. Sandbox
# credentials only — never a real institution's production credentials in
# development. Never exposed to the browser (only a short-lived Connect
# Token generated from these is).
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=

# Optional. Without a public URL, Pluggy's webhooks cannot reach local dev
# at all (a documented constraint, not a gap — see docs/OPEN-FINANCE.md,
# "Local development caveat") — the Connect widget's own onSuccess callback
# remains the only local path to learn about a new connection. Leave unset
# locally. Also: `resolveWebhookUrl()` never builds a URL at all outside
# staging/production (see below and docs/DECISIONS.md, Founder Local Live
# Bank Pilot entry), so this has no effect in development/test regardless.
PLUGGY_WEBHOOK_SECRET=

# ---- Founder Local Live Bank Pilot (see docs/DECISIONS.md, Founder Local
# Live Bank Pilot entry; docs/OPEN-FINANCE.md) ----
# Leave BOTH unset for ordinary sandbox development (the default everywhere,
# including this app's automated tests) — Pluggy's sandbox connectors only,
# no real institution ever reachable. Real financial institution connectors
# ("live" Open Finance data) activate ONLY when ALL THREE of the following
# are simultaneously true: APP_ENV resolves to exactly "development" (never
# staging/production — there is no override for that), OPEN_FINANCE_MODE is
# exactly "live", AND FOUNDER_LIVE_BANK_PILOT is exactly "true". Any one
# missing silently and safely falls back to sandbox — see
# `open-finance-mode.server.ts`. This exists for a single narrow scenario:
# the Founder personally piloting Ritmo against their own real bank, on
# their own machine, with the app still talking to local PGlite (never a
# deployed environment, never a shared database). PLUGGY_CLIENT_ID/SECRET
# above must also be REAL (non-sandbox) credentials for this to do anything
# useful — enter those directly in your own apps/ritmo/.env.local, never in
# chat, never logged, never exposed to the browser.
OPEN_FINANCE_MODE=
FOUNDER_LIVE_BANK_PILOT=

# ---- OpenAI (server-only secret — see docs/AI-COPILOT.md, docs/RITMO.md) ----
# Used ONLY on the server (src/functions/assistente.ts, via @money-copilot/ai)
# to call the OpenAI Responses API — never exposed to the browser, persisted,
# or logged. Leave unset to run without live AI chat: every other screen keeps
# working, and the Assistente screen returns a clear configuration-error state
# instead of silently degrading. Automated tests never require this.
OPENAI_API_KEY=

# Overrides the default AI model. Leave unset to use the default.
OPENAI_MODEL=

# ---- Local persistence (development/test only) ----
# Path to the local PGlite (embedded Postgres-compatible) data file. No
# hosted database or credentials are required for local dev or tests. Never
# used when APP_ENV is staging/production — see docs/DECISIONS.md.
MONEY_COPILOT_DB_PATH=./.data/money-copilot.pglite
